    "/videos": {
      "post": {
        "description": "Creates the video as a draft in the authenticated user's channel, opens a multipart upload in the object storage and returns presigned URLs for every part. The client uploads each part with PUT straight to the storage; the file never passes through the API.",
        "operationId": "VideosController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVideoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created and upload started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateVideoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (unsupported MIME type, size or filename)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/public/{publicId}": {
      "get": {
        "description": "Returns the public data of a ready video accessed through its unique link. No authentication required.",
        "operationId": "VideosController_getPublic",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Unique public identifier (11 base64url characters)",
            "schema": {
              "example": "dQw4w9WgXcQ",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public data of the ready video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicVideoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Invalid public id, unknown video or video not ready (same response for all)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get public video data",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/public/{publicId}/stream": {
      "get": {
        "description": "Streams the video from the object storage, forwarding the Range header. Answers 206 Partial Content for a valid range and 200 with the whole file otherwise. No authentication required.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "dQw4w9WgXcQ",
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range: bytes=start-end, bytes=start- or bytes=-suffix",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whole file (no Range header)",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/webm": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/quicktime": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/x-matroska": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested byte range, with Content-Range",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/webm": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/quicktime": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/x-matroska": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Invalid public id, unknown video or video not ready",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/webm": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/quicktime": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/x-matroska": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range starts beyond the end of the file; Content-Range: bytes */{size}",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/webm": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/quicktime": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/x-matroska": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a ready video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/public/{publicId}/thumbnail": {
      "get": {
        "description": "Returns the JPEG thumbnail generated by the video worker. No authentication required.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "dQw4w9WgXcQ",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Invalid public id, unknown video, video not ready or without thumbnail",
            "content": {
              "image/jpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get the thumbnail of a ready video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/public/{publicId}/download": {
      "get": {
        "description": "Redirects (302) to a short-lived presigned URL that serves the original file with Content-Disposition: attachment. No authentication required.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "dQw4w9WgXcQ",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned download URL (Location header)"
          },
          "404": {
            "description": "Invalid public id, unknown video or video not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a ready video",
        "tags": [
          "videos"
        ]
      }
    },
